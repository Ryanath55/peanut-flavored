# What packwiz should NOT ship in the distributable pack.
# Mirrors .gitignore's intent, but this one governs the exported .mrpack:
# config files SHOULD ship, personal state and raw jars should not.

# Raw jars — packwiz tracks them as mods/*.pw.toml instead
/mods/*.jar
/mods/*.jar.disabled
/mods/modlist.md

# Launcher / runtime output
/saves/
/logs/
/screenshots/
/crash-reports/
/debug/
/downloads/
/.cache/
/.mixin.out/
/.sable/
/dynamic-resource-pack-cache/
# The patch pack is the exception: built from tools/patchpack, and the only place its
# overrides actually outrank the mods they patch. Everything else here is machine-local.
/moonlight-global-datapacks/*
!/moonlight-global-datapacks/packpatches.zip
/data/
/schematics/

# Third-party redistributables, not ours to ship
/shaderpacks/
/resourcepacks/

# Personal state
/options.txt
/usercache.json
/usernamecache.json
/emi.json
/ponders_watched.json
/command_history.txt
/config/sodium-fingerprint.json
/config/resourceful-config-web.json
*.bak

# Repo furniture
/.git/
/.gitignore
/.gitattributes
/.packwizignore
/README.md
/REGISTER.md
/packreg.py
/PACKREG.md
/tools/
