# Barren Skies test pack — allowlist model.
# A Minecraft instance sprouts new junk directories constantly (caches, saves,
# crash dumps), so ignore everything at the root and re-add only what is pack
# configuration. Nested content under an un-ignored directory is tracked.

/*

!/.gitignore
!/.gitattributes
!/.packwizignore
!/README.md
!/REGISTER.md
!/packreg.py
!/tools/
!/config/
!/defaultconfigs/
!/datapacks/
!/mods/
# Built from tools/patchpack. A datapack inside a mod jar cannot override another mod's
# data: NeoForge folds every mod jar into one bundled pack that outranks them all.
# Moonlight loads this folder after that pack, which is the only way the patches win.
!/moonlight-global-datapacks/
/moonlight-global-datapacks/*
!/moonlight-global-datapacks/packpatches.zip
!/options.txt

# packwiz pack definition
!/pack.toml
!/index.toml

# Mod jars are ~271 MB and all re-downloadable. packwiz tracks each mod as a
# small .pw.toml holding its project id, version id, URL and hash.
/mods/*
!/mods/*.pw.toml

# Machine-specific / not worth publishing
/config/sodium-fingerprint.json
/config/resourceful-config-web.json

# Backup files mods leave behind
*.bak
